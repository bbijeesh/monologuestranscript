<Window x:Class="mystickymonologues.Views.NotesListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saved Notes – MyStickyMonologues"
        Height="540" Width="420"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushText}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="10" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
            Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushAccent}" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="☰  Saved Notes" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="32" Height="32" HorizontalAlignment="Right" Margin="0,0,6,0"
                            Click="CloseButton_Click" Style="{StaticResource TitleBarBtn}"
                            Foreground="{StaticResource BrushDanger}" Padding="0"/>
                </Grid>
            </Border>

            <!-- Notes List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,6,14,14">
                <StackPanel x:Name="NotesPanel"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
