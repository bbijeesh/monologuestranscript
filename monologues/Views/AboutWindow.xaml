<Window x:Class="mystickymonologues.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About – MyStickyMonologues"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushText}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="10" BorderBrush="{StaticResource BrushBackground}" BorderThickness="1" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushBackground}" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="ℹ About" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="36" Height="36" HorizontalAlignment="Right" Margin="0,0,6,0"
                            Click="CloseButton_Click" Style="{StaticResource TitleBarBtn}" Padding="0"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="28,20,28,20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- Logo -->
                    <Image x:Name="LogoImage" 
                           Width="120" Height="120" Margin="0,0,0,5"/>

                    <!-- Title -->
                    <TextBlock Text="Monologues" FontSize="24" FontWeight="Bold" 
                               Foreground="{StaticResource BrushPrimary}" 
                               HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <!-- Copyright -->
                    <TextBlock Text="qbitsol ®" FontSize="14" 
                               Foreground="{StaticResource BrushText}" 
                               HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <!-- Description -->
                    <TextBlock Text="Your digital sticky notes powered by AI" FontSize="12" 
                               Foreground="{StaticResource BrushTextMuted}" 
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Info -->
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Margin="0,5,0,5">
                            <Run Text="Version: " Foreground="{StaticResource BrushTextMuted}"/>
                            <Run x:Name="VersionText" Text="0.4.6" Foreground="{StaticResource BrushText}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource BrushBackgroundDark}" CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Button Content="Close" Click="Close_Click" Style="{StaticResource ButtonBase}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
