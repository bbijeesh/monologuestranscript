<Window x:Class="mystickymonologues.Views.StickyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyStickyMonologues"
        Height="380" Width="320"
        MinHeight="200" MinWidth="220"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushText}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown">

    <Border x:Name="MainBorder" CornerRadius="10" BorderBrush="{StaticResource BrushBackground}" BorderThickness="1" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushAccent}" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <!-- + New Window -->
                    <Button x:Name="BtnNew" Grid.Column="0" Content="+" FontSize="20" FontWeight="Bold"
                            ToolTip="New Sticky Note" Click="BtnNew_Click"
                            Style="{StaticResource TitleBarBtn}" Foreground="{StaticResource BrushTextMuted}" Margin="6,0,0,0"/>

                    <!-- Mic Button centered in title bar -->
                    <Button x:Name="BtnMic" Grid.Column="1" Content="🎙" FontSize="16"
                            Click="BtnMic_Click"
                            Style="{StaticResource MicBtn}"
                            ToolTip="Press to record"/>

                    <!-- Gear + Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnSettings" Content="⚙" FontSize="15"
                                ToolTip="Settings" Click="BtnSettings_Click"
                                Style="{StaticResource TitleBarBtn}" Foreground="{StaticResource BrushTextMuted}"
                                Visibility="Collapsed"/>
                    </StackPanel>

                    <Button x:Name="BtnClose" Grid.Column="3" Content="✕" FontSize="14"
                            ToolTip="Close" Click="BtnClose_Click"
                            Style="{StaticResource TitleBarBtn}" Foreground="{StaticResource BrushDanger}" Margin="0,0,6,0"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="12,8,12,60">
                    <TextBox x:Name="TxtNotes"
                             Background="Transparent"
                             Foreground="{StaticResource BrushText}"
                             BorderThickness="0"
                             FontSize="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             FontFamily="MS Sans Serif"
                             VerticalAlignment="Stretch"
                             CaretBrush="{StaticResource BrushText}"
                             SelectionBrush="{StaticResource BrushPrimary}"
                             TextChanged="TxtNotes_TextChanged"/>
                </ScrollViewer>


            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource BrushBackgroundDark}" CornerRadius="0,0,10,10">
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="{StaticResource BrushTextMuted}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0"/>
            </Border>
        </Grid>
    </Border>
</Window>
