<Window x:Class="mystickymonologues.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings – MyStickyMonologues"
        Height="833" Width="497"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushText}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="10" BorderBrush="{StaticResource BrushBackground}" BorderThickness="1" Background="{StaticResource BrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushBackground}" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="⚙ Settings" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="✕" Width="36" Height="36" HorizontalAlignment="Right" Margin="0,0,6,0"
                            Click="CloseButton_Click" Style="{StaticResource TitleBarBtn}" Padding="0"/>
                </Grid>
            </Border>

            <!-- Settings Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,10,28,10">
                <StackPanel>
                    <TextBlock Text="Profile" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0"/>
                    <Separator Background="{StaticResource BrushBorder}" Margin="0,4,0,0"/>

                    <TextBlock Text="Your Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtName" Style="{StaticResource InputStyle}" Height="33"/>

                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtEmail" Style="{StaticResource InputStyle}"/>

                    <TextBlock Text="AI Configuration" Style="{StaticResource MutedTextStyle}" Margin="0,18,0,0"/>
                    <Separator Background="{StaticResource BrushBorder}" Margin="0,4,0,0"/>

                    <TextBlock Text="Select AI Model" Style="{StaticResource LabelStyle}"/>
                    <Border Background="{StaticResource BrushBackgroundLight}" CornerRadius="6" Height="90" Margin="0,8,0,12">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ModelsContainer">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="API Key" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtApiKey" Style="{StaticResource InputStyle}" 
                             TextChanged="ApiKey_Changed"/>

                    <TextBlock Text="— or —" Foreground="{StaticResource BrushBorder}" HorizontalAlignment="Center" Margin="0,6"/>

                    <TextBlock Text="Path to API Key File" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtKeyFile" Style="{StaticResource InputStyle}" Grid.Column="0"/>
                        <Button Content="Browse" Grid.Column="1" Margin="6,0,0,0" Height="34"
                                Click="BrowseKeyFile_Click" Style="{StaticResource ButtonBase}" Padding="12,0"/>
                    </Grid>

                    <TextBlock Text="Storage" Style="{StaticResource MutedTextStyle}" Margin="0,18,0,0"/>
                    <Separator Background="{StaticResource BrushBorder}" Margin="0,4,0,0"/>

                    <TextBlock Text="Notes Folder" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNotesFolder" Style="{StaticResource InputStyle}" Grid.Column="0"/>
                        <Button Content="Browse" Grid.Column="1" Margin="6,0,0,0" Height="34"
                                Click="BrowseFolder_Click" Style="{StaticResource ButtonBase}" Padding="12,0"/>
                    </Grid>

                    <TextBlock Text="Max Sticky Windows (1–10)" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtMaxWindows" Style="{StaticResource InputStyle}" Width="80" HorizontalAlignment="Left"/>

                    <TextBlock x:Name="TxtStatus" Text="" Foreground="{StaticResource BrushDanger}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource BrushBackgroundDark}" CornerRadius="0,0,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- About Link -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="24,0,0,0">
                        <Button Content="About" Click="About_Click" Style="{StaticResource ButtonBase}" 
                                Background="Transparent" Foreground="{StaticResource BrushPrimary}" 
                                FontSize="12" Padding="0"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource ButtonBase}" 
                                Background="#333" Margin="0,0,10,0"/>
                        <Button Content="Save Settings" Click="Save_Click" Style="{StaticResource ButtonBase}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
